<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#"
     xml:base="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:medical-device-ivd-ontology="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology">
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <rdfs:label>Medical Device and In Vitro Diagnostic Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#addressesIncident -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#addressesIncident">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:comment>Relates a field safety corrective action to the incident it addresses.</rdfs:comment>
        <rdfs:label>addresses incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#affectsDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#affectsDevice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:comment>Relates an incident to the device affected by it.</rdfs:comment>
        <rdfs:label>affects device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceAssociatedWithRisk -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceAssociatedWithRisk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:comment>Relates a device to a risk inferred from an associated incident.</rdfs:comment>
        <rdfs:label>device associated with risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaRelatedToDevice -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaRelatedToDevice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:comment>Relates a field safety corrective action to a device through the incident it addresses.</rdfs:comment>
        <rdfs:label>FSCA related to device</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasActionType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasActionType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ActionType"/>
        <rdfs:comment>Relates a field safety corrective action to its action type.</rdfs:comment>
        <rdfs:label>has action type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasAffectedDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasAffectedDeviceType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#AffectedDeviceType"/>
        <rdfs:comment>Relates a risk to the type of device it affects.</rdfs:comment>
        <rdfs:label>has affected device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasDeviceType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasDeviceType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#DeviceType"/>
        <rdfs:comment>Relates a device to its device type.</rdfs:comment>
        <rdfs:label>has device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasFSCAStatus -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasFSCAStatus">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FSCAStatus"/>
        <rdfs:comment>Relates a field safety corrective action to its status.</rdfs:comment>
        <rdfs:label>has FSCA status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasIncidentType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasIncidentType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IncidentType"/>
        <rdfs:comment>Relates an incident to its incident type.</rdfs:comment>
        <rdfs:label>has incident type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasManufacturer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:comment>Relates a device to its manufacturer.</rdfs:comment>
        <rdfs:label>has manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasPatientOutcome -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasPatientOutcome">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientOutcome"/>
        <rdfs:comment>Relates an incident to the patient outcome.</rdfs:comment>
        <rdfs:label>has patient outcome</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasPatientSex -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasPatientSex">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientSex"/>
        <rdfs:comment>Relates an incident to the patient sex category.</rdfs:comment>
        <rdfs:label>has patient sex</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasProbabilityLevel -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasProbabilityLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ProbabilityLevel"/>
        <rdfs:comment>Relates a risk to its probability level.</rdfs:comment>
        <rdfs:label>has probability level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRisk -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRisk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:comment>Relates an incident to the associated risk.</rdfs:comment>
        <rdfs:label>has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskCategory -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskCategory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskCategory"/>
        <rdfs:comment>Relates a risk to its risk category.</rdfs:comment>
        <rdfs:label>has risk category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskClass -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskClass">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskClass"/>
        <rdfs:comment>Relates a device to its regulatory risk class.</rdfs:comment>
        <rdfs:label>has risk class</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskType -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskType"/>
        <rdfs:comment>Relates a device to its device type.</rdfs:comment>
        <rdfs:label>has device type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasSeverityLevel -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasSeverityLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#SeverityLevel"/>
        <rdfs:comment>Relates a risk to its severity level.</rdfs:comment>
        <rdfs:label>has severity level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentReportedForManufacturer -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentReportedForManufacturer">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:comment>Relates an incident to the manufacturer of the affected device.</rdfs:comment>
        <rdfs:label>incident reported for manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#regulatedUnder -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#regulatedUnder">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RegulatoryFramework"/>
        <rdfs:comment>Relates a device to the regulatory framework that applies to it.</rdfs:comment>
        <rdfs:label>regulated under</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#reportedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ReportingEntity"/>
        <rdfs:comment>Relates an incident to the reporting entity.</rdfs:comment>
        <rdfs:label>reported by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#actionDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#actionDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the field safety corrective action was initiated.</rdfs:comment>
        <rdfs:label>action date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#authorizationNumber -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#authorizationNumber">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Official authorization number assigned to the manufacturer.</rdfs:comment>
        <rdfs:label>authorization number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#closureDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#closureDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the field safety corrective action was closed.</rdfs:comment>
        <rdfs:label>closure date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#competentAuthorityName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#competentAuthorityName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Name of the competent authority responsible for the manufacturer.</rdfs:comment>
        <rdfs:label>competent authority name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#contactEmail -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#contactEmail">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Contact email address of the manufacturer.</rdfs:comment>
        <rdfs:label>contact email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#correctiveActionTaken -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#correctiveActionTaken">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean value indicating whether a corrective action was taken.</rdfs:comment>
        <rdfs:label>corrective action taken</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#countriesAffectedText -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#countriesAffectedText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of the countries or regions affected by the corrective action.</rdfs:comment>
        <rdfs:label>countries affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#country -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#country">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Country where the manufacturer is registered.</rdfs:comment>
        <rdfs:label>country</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#countryReported -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#countryReported">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Country where the incident was reported.</rdfs:comment>
        <rdfs:label>country reported</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#detectionDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#detectionDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the incident was detected.</rdfs:comment>
        <rdfs:label>detection date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier assigned to a device instance.</rdfs:comment>
        <rdfs:label>device identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Human-readable name of the device.</rdfs:comment>
        <rdfs:label>device name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#devicesAffectedText -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#devicesAffectedText">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual value indicating the number or extent of affected devices or tests.</rdfs:comment>
        <rdfs:label>devices affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedFSCARef -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedFSCARef">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reference code assigned to the field safety corrective action in EUDAMED.</rdfs:comment>
        <rdfs:label>EUDAMED FSCA reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedIncidentRef -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedIncidentRef">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reference code assigned to the incident in EUDAMED.</rdfs:comment>
        <rdfs:label>EUDAMED incident reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedSRN -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedSRN">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Single Registration Number assigned in EUDAMED.</rdfs:comment>
        <rdfs:label>EUDAMED SRN</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eventDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eventDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the incident event occurred.</rdfs:comment>
        <rdfs:label>event date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaDescription -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of the field safety corrective action.</rdfs:comment>
        <rdfs:label>FSCA description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier assigned to a field safety corrective action instance.</rdfs:comment>
        <rdfs:label>FSCA identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#imdrfCode -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#imdrfCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Official IMDRF code assigned to the risk.</rdfs:comment>
        <rdfs:label>IMDRF code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentDescription -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of the incident.</rdfs:comment>
        <rdfs:label>incident description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier assigned to an incident instance.</rdfs:comment>
        <rdfs:label>incident identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#intendedPurpose -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#intendedPurpose">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of the intended purpose of the device.</rdfs:comment>
        <rdfs:label>intended purpose</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isActive -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isActive">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean value indicating whether the device is classified as active.</rdfs:comment>
        <rdfs:label>is active</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isIVD -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isIVD">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean value indicating whether the device is an in vitro diagnostic device.</rdfs:comment>
        <rdfs:label>is IVD</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isImplantable -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isImplantable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean value indicating whether the device is implantable.</rdfs:comment>
        <rdfs:label>is implantable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isReusable -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isReusable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Boolean value indicating whether the device is reusable.</rdfs:comment>
        <rdfs:label>is reusable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#manufacturerId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#manufacturerId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier assigned to a manufacturer instance.</rdfs:comment>
        <rdfs:label>manufacturer identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#manufacturerName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#manufacturerName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Human-readable name of the manufacturer.</rdfs:comment>
        <rdfs:label>manufacturer name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#patientAge -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#patientAge">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Age of the patient involved in the incident.</rdfs:comment>
        <rdfs:label>patient age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#reportDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#reportDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the incident was reported.</rdfs:comment>
        <rdfs:label>report date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskDescription -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of the risk and its effects.</rdfs:comment>
        <rdfs:label>risk description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskId -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identifier assigned to a risk instance.</rdfs:comment>
        <rdfs:label>risk identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Human-readable name of the risk.</rdfs:comment>
        <rdfs:label>risk name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#scopeDescription -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#scopeDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual description of the scope of the corrective action.</rdfs:comment>
        <rdfs:label>scope description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#udiDI -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#udiDI">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique Device Identification - Device Identifier assigned to the device.</rdfs:comment>
        <rdfs:label>UDI-DI</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ActionType -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ActionType">
        <rdfs:comment>Represents the type of field safety corrective action performed.</rdfs:comment>
        <rdfs:label>Action Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#AffectedDeviceType -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#AffectedDeviceType">
        <rdfs:comment>Represents the type of device affected by a specific risk.</rdfs:comment>
        <rdfs:label>Affected Device Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasManufacturer"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a medical device or an in vitro diagnostic device registered in the ontology.</rdfs:comment>
        <rdfs:label>Device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Medical_device"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#DeviceType -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#DeviceType">
        <rdfs:comment>Represents the type or category of a device.</rdfs:comment>
        <rdfs:label>Device Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FSCAStatus -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FSCAStatus">
        <rdfs:comment>Represents the status of a field safety corrective action.</rdfs:comment>
        <rdfs:label>FSCA Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#addressesIncident"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a corrective action taken in the field in response to a reported incident.</rdfs:comment>
        <rdfs:label>Field Safety Corrective Action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IVDRFramework -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IVDRFramework">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RegulatoryFramework"/>
        <rdfs:comment>Represents the In Vitro Diagnostic Regulation framework.</rdfs:comment>
        <rdfs:label>IVDR Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#InVitroDiagnosticDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#InVitroDiagnosticDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:comment>Represents an in vitro diagnostic device regulated under the ontology.</rdfs:comment>
        <rdfs:label>In Vitro Diagnostic Device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/In_vitro_diagnostics"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#affectsDevice"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a reported incident associated with a device and a risk.</rdfs:comment>
        <rdfs:label>Incident</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IncidentType -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IncidentType">
        <rdfs:comment>Represents the type of a reported incident.</rdfs:comment>
        <rdfs:label>Incident Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#MDRFramework -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#MDRFramework">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RegulatoryFramework"/>
        <rdfs:comment>Represents the Medical Device Regulation framework.</rdfs:comment>
        <rdfs:label>MDR Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer">
        <rdfs:comment>Represents the organization responsible for manufacturing a device.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#MedicalDevice -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#MedicalDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device"/>
        <rdfs:comment>Represents a medical device regulated under the ontology.</rdfs:comment>
        <rdfs:label>Medical Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientOutcome -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientOutcome">
        <rdfs:comment>Represents the outcome experienced by the patient in an incident.</rdfs:comment>
        <rdfs:label>Patient Outcome</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientSex -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientSex">
        <rdfs:comment>Represents the sex category associated with a patient involved in an incident.</rdfs:comment>
        <rdfs:label>Patient Sex</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ProbabilityLevel -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ProbabilityLevel">
        <rdfs:comment>Represents the probability level associated with a risk.</rdfs:comment>
        <rdfs:label>Probability Level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RegulatoryFramework -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RegulatoryFramework">
        <rdfs:comment>Represents the regulatory framework under which a device is classified.</rdfs:comment>
        <rdfs:label>Regulatory Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ReportingEntity -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ReportingEntity">
        <rdfs:comment>Represents the entity that reports an incident.</rdfs:comment>
        <rdfs:label>Reporting Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskCategory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskCategory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents a risk identified for a medical device or in vitro diagnostic device.</rdfs:comment>
        <rdfs:label>Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskCategory -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskCategory">
        <rdfs:comment>Represents a high-level category used to classify risks.</rdfs:comment>
        <rdfs:label>Risk Category</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskClass -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskClass">
        <rdfs:comment>Represents the regulatory risk classification assigned to a device.</rdfs:comment>
        <rdfs:label>Risk Class</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskType -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskType">
        <rdfs:comment>Represents the specific type of a risk.</rdfs:comment>
        <rdfs:label>Risk Type</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#SeverityLevel -->


    <owl:Class rdf:about="http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#SeverityLevel">
        <rdfs:comment>Represents the severity level associated with a risk.</rdfs:comment>
        <rdfs:label>Severity Level</rdfs:label>
    </owl:Class>
    


