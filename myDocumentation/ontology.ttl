@prefix : <http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#> .

<http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology> rdf:type owl:Ontology ;
                                                                                  <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/" ;
                                                                                  rdfs:label "Medical Device and In Vitro Diagnostic Ontology" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty ;
                                   rdfs:subPropertyOf rdfs:comment .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#addressesIncident
:addressesIncident rdf:type owl:ObjectProperty ;
                   rdfs:domain :FieldSafetyCorrectiveAction ;
                   rdfs:range :Incident ;
                   rdfs:comment "Relates a field safety corrective action to the incident it addresses." ;
                   rdfs:label "addresses incident" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#affectsDevice
:affectsDevice rdf:type owl:ObjectProperty ;
               rdfs:domain :Incident ;
               rdfs:range :Device ;
               rdfs:comment "Relates an incident to the device affected by it." ;
               rdfs:label "affects device" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceAssociatedWithRisk
:deviceAssociatedWithRisk rdf:type owl:ObjectProperty ;
                          rdfs:domain :Device ;
                          rdfs:range :Risk ;
                          rdfs:comment "Relates a device to a risk inferred from an associated incident." ;
                          rdfs:label "device associated with risk" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaRelatedToDevice
:fscaRelatedToDevice rdf:type owl:ObjectProperty ;
                     rdfs:domain :FieldSafetyCorrectiveAction ;
                     rdfs:range :Device ;
                     rdfs:comment "Relates a field safety corrective action to a device through the incident it addresses." ;
                     rdfs:label "FSCA related to device" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasActionType
:hasActionType rdf:type owl:ObjectProperty ;
               rdfs:domain :FieldSafetyCorrectiveAction ;
               rdfs:range :ActionType ;
               rdfs:comment "Relates a field safety corrective action to its action type." ;
               rdfs:label "has action type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasAffectedDeviceType
:hasAffectedDeviceType rdf:type owl:ObjectProperty ;
                       rdfs:domain :Risk ;
                       rdfs:range :AffectedDeviceType ;
                       rdfs:comment "Relates a risk to the type of device it affects." ;
                       rdfs:label "has affected device type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasDeviceType
:hasDeviceType rdf:type owl:ObjectProperty ;
               rdfs:domain :Device ;
               rdfs:range :DeviceType ;
               rdfs:comment "Relates a device to its device type." ;
               rdfs:label "has device type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasFSCAStatus
:hasFSCAStatus rdf:type owl:ObjectProperty ;
               rdfs:domain :FieldSafetyCorrectiveAction ;
               rdfs:range :FSCAStatus ;
               rdfs:comment "Relates a field safety corrective action to its status." ;
               rdfs:label "has FSCA status" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasIncidentType
:hasIncidentType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Incident ;
                 rdfs:range :IncidentType ;
                 rdfs:comment "Relates an incident to its incident type." ;
                 rdfs:label "has incident type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasManufacturer
:hasManufacturer rdf:type owl:ObjectProperty ;
                 rdfs:domain :Device ;
                 rdfs:range :Manufacturer ;
                 rdfs:comment "Relates a device to its manufacturer." ;
                 rdfs:label "has manufacturer" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasPatientOutcome
:hasPatientOutcome rdf:type owl:ObjectProperty ;
                   rdfs:domain :Incident ;
                   rdfs:range :PatientOutcome ;
                   rdfs:comment "Relates an incident to the patient outcome." ;
                   rdfs:label "has patient outcome" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasPatientSex
:hasPatientSex rdf:type owl:ObjectProperty ;
               rdfs:domain :Incident ;
               rdfs:range :PatientSex ;
               rdfs:comment "Relates an incident to the patient sex category." ;
               rdfs:label "has patient sex" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasProbabilityLevel
:hasProbabilityLevel rdf:type owl:ObjectProperty ;
                     rdfs:domain :Risk ;
                     rdfs:range :ProbabilityLevel ;
                     rdfs:comment "Relates a risk to its probability level." ;
                     rdfs:label "has probability level" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         rdfs:domain :Incident ;
         rdfs:range :Risk ;
         rdfs:comment "Relates an incident to the associated risk." ;
         rdfs:label "has risk" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskCategory
:hasRiskCategory rdf:type owl:ObjectProperty ;
                 rdfs:domain :Risk ;
                 rdfs:range :RiskCategory ;
                 rdfs:comment "Relates a risk to its risk category." ;
                 rdfs:label "has risk category" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskClass
:hasRiskClass rdf:type owl:ObjectProperty ;
              rdfs:domain :Device ;
              rdfs:range :RiskClass ;
              rdfs:comment "Relates a device to its regulatory risk class." ;
              rdfs:label "has risk class" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasRiskType
:hasRiskType rdf:type owl:ObjectProperty ;
             rdfs:domain :Risk ;
             rdfs:range :RiskType ;
             rdfs:comment "Relates a device to its device type." ;
             rdfs:label "has device type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#hasSeverityLevel
:hasSeverityLevel rdf:type owl:ObjectProperty ;
                  rdfs:domain :Risk ;
                  rdfs:range :SeverityLevel ;
                  rdfs:comment "Relates a risk to its severity level." ;
                  rdfs:label "has severity level" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentReportedForManufacturer
:incidentReportedForManufacturer rdf:type owl:ObjectProperty ;
                                 rdfs:domain :Incident ;
                                 rdfs:range :Manufacturer ;
                                 rdfs:comment "Relates an incident to the manufacturer of the affected device." ;
                                 rdfs:label "incident reported for manufacturer" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#regulatedUnder
:regulatedUnder rdf:type owl:ObjectProperty ;
                rdfs:domain :Device ;
                rdfs:range :RegulatoryFramework ;
                rdfs:comment "Relates a device to the regulatory framework that applies to it." ;
                rdfs:label "regulated under" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#reportedBy
:reportedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Incident ;
            rdfs:range :ReportingEntity ;
            rdfs:comment "Relates an incident to the reporting entity." ;
            rdfs:label "reported by" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#actionDate
:actionDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :FieldSafetyCorrectiveAction ;
            rdfs:range xsd:date ;
            rdfs:comment "Date when the field safety corrective action was initiated." ;
            rdfs:label "action date" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#authorizationNumber
:authorizationNumber rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Manufacturer ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Official authorization number assigned to the manufacturer." ;
                     rdfs:label "authorization number" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#closureDate
:closureDate rdf:type owl:DatatypeProperty ;
             rdfs:domain :FieldSafetyCorrectiveAction ;
             rdfs:range xsd:date ;
             rdfs:comment "Date when the field safety corrective action was closed." ;
             rdfs:label "closure date" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#competentAuthorityName
:competentAuthorityName rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Manufacturer ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Name of the competent authority responsible for the manufacturer." ;
                        rdfs:label "competent authority name" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#contactEmail
:contactEmail rdf:type owl:DatatypeProperty ;
              rdfs:domain :Manufacturer ;
              rdfs:range xsd:string ;
              rdfs:comment "Contact email address of the manufacturer." ;
              rdfs:label "contact email" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#correctiveActionTaken
:correctiveActionTaken rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Incident ;
                       rdfs:range xsd:boolean ;
                       rdfs:comment "Boolean value indicating whether a corrective action was taken." ;
                       rdfs:label "corrective action taken" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#countriesAffectedText
:countriesAffectedText rdf:type owl:DatatypeProperty ;
                       rdfs:domain :FieldSafetyCorrectiveAction ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Textual description of the countries or regions affected by the corrective action." ;
                       rdfs:label "countries affected" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#country
:country rdf:type owl:DatatypeProperty ;
         rdfs:domain :Manufacturer ;
         rdfs:range xsd:string ;
         rdfs:comment "Country where the manufacturer is registered." ;
         rdfs:label "country" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#countryReported
:countryReported rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Incident ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Country where the incident was reported." ;
                 rdfs:label "country reported" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#detectionDate
:detectionDate rdf:type owl:DatatypeProperty ;
               rdfs:domain :Incident ;
               rdfs:range xsd:date ;
               rdfs:comment "Date when the incident was detected." ;
               rdfs:label "detection date" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceId
:deviceId rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:string ;
          rdfs:comment "Unique identifier assigned to a device instance." ;
          rdfs:label "device identifier" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#deviceName
:deviceName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:string ;
            rdfs:comment "Human-readable name of the device." ;
            rdfs:label "device name" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#devicesAffectedText
:devicesAffectedText rdf:type owl:DatatypeProperty ;
                     rdfs:domain :FieldSafetyCorrectiveAction ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Textual value indicating the number or extent of affected devices or tests." ;
                     rdfs:label "devices affected" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedFSCARef
:eudamedFSCARef rdf:type owl:DatatypeProperty ;
                rdfs:domain :FieldSafetyCorrectiveAction ;
                rdfs:range xsd:string ;
                rdfs:comment "Reference code assigned to the field safety corrective action in EUDAMED." ;
                rdfs:label "EUDAMED FSCA reference" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedIncidentRef
:eudamedIncidentRef rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Incident ;
                    rdfs:range xsd:string ;
                    rdfs:comment "Reference code assigned to the incident in EUDAMED." ;
                    rdfs:label "EUDAMED incident reference" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eudamedSRN
:eudamedSRN rdf:type owl:DatatypeProperty ;
            rdfs:domain :Manufacturer ;
            rdfs:range xsd:string ;
            rdfs:comment "Single Registration Number assigned in EUDAMED." ;
            rdfs:label "EUDAMED SRN" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#eventDate
:eventDate rdf:type owl:DatatypeProperty ;
           rdfs:domain :Incident ;
           rdfs:range xsd:date ;
           rdfs:comment "Date when the incident event occurred." ;
           rdfs:label "event date" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaDescription
:fscaDescription rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FieldSafetyCorrectiveAction ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Textual description of the field safety corrective action." ;
                 rdfs:label "FSCA description" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#fscaId
:fscaId rdf:type owl:DatatypeProperty ;
        rdfs:domain :FieldSafetyCorrectiveAction ;
        rdfs:range xsd:string ;
        rdfs:comment "Unique identifier assigned to a field safety corrective action instance." ;
        rdfs:label "FSCA identifier" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#imdrfCode
:imdrfCode rdf:type owl:DatatypeProperty ;
           rdfs:domain :Risk ;
           rdfs:range xsd:string ;
           rdfs:comment "Official IMDRF code assigned to the risk." ;
           rdfs:label "IMDRF code" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentDescription
:incidentDescription rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Incident ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Textual description of the incident." ;
                     rdfs:label "incident description" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#incidentId
:incidentId rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:string ;
            rdfs:comment "Unique identifier assigned to an incident instance." ;
            rdfs:label "incident identifier" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#intendedPurpose
:intendedPurpose rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Device ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Textual description of the intended purpose of the device." ;
                 rdfs:label "intended purpose" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isActive
:isActive rdf:type owl:DatatypeProperty ;
          rdfs:domain :Device ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Boolean value indicating whether the device is classified as active." ;
          rdfs:label "is active" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isIVD
:isIVD rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:boolean ;
       rdfs:comment "Boolean value indicating whether the device is an in vitro diagnostic device." ;
       rdfs:label "is IVD" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isImplantable
:isImplantable rdf:type owl:DatatypeProperty ;
               rdfs:domain :Device ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Boolean value indicating whether the device is implantable." ;
               rdfs:label "is implantable" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#isReusable
:isReusable rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:boolean ;
            rdfs:comment "Boolean value indicating whether the device is reusable." ;
            rdfs:label "is reusable" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#manufacturerId
:manufacturerId rdf:type owl:DatatypeProperty ;
                rdfs:domain :Manufacturer ;
                rdfs:range xsd:string ;
                rdfs:comment "Unique identifier assigned to a manufacturer instance." ;
                rdfs:label "manufacturer identifier" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#manufacturerName
:manufacturerName rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Manufacturer ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Human-readable name of the manufacturer." ;
                  rdfs:label "manufacturer name" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#patientAge
:patientAge rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:integer ;
            rdfs:comment "Age of the patient involved in the incident." ;
            rdfs:label "patient age" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#reportDate
:reportDate rdf:type owl:DatatypeProperty ;
            rdfs:domain :Incident ;
            rdfs:range xsd:date ;
            rdfs:comment "Date when the incident was reported." ;
            rdfs:label "report date" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskDescription
:riskDescription rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Risk ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Textual description of the risk and its effects." ;
                 rdfs:label "risk description" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskId
:riskId rdf:type owl:DatatypeProperty ;
        rdfs:domain :Risk ;
        rdfs:range xsd:string ;
        rdfs:comment "Unique identifier assigned to a risk instance." ;
        rdfs:label "risk identifier" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#riskName
:riskName rdf:type owl:DatatypeProperty ;
          rdfs:domain :Risk ;
          rdfs:range xsd:string ;
          rdfs:comment "Human-readable name of the risk." ;
          rdfs:label "risk name" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#scopeDescription
:scopeDescription rdf:type owl:DatatypeProperty ;
                  rdfs:domain :FieldSafetyCorrectiveAction ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Textual description of the scope of the corrective action." ;
                  rdfs:label "scope description" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#udiDI
:udiDI rdf:type owl:DatatypeProperty ;
       rdfs:domain :Device ;
       rdfs:range xsd:string ;
       rdfs:comment "Unique Device Identification - Device Identifier assigned to the device." ;
       rdfs:label "UDI-DI" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ActionType
:ActionType rdf:type owl:Class ;
            rdfs:comment "Represents the type of field safety corrective action performed." ;
            rdfs:label "Action Type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#AffectedDeviceType
:AffectedDeviceType rdf:type owl:Class ;
                    rdfs:comment "Represents the type of device affected by a specific risk." ;
                    rdfs:label "Affected Device Type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :hasManufacturer ;
                          owl:someValuesFrom :Manufacturer
                        ] ;
        rdfs:comment "Represents a medical device or an in vitro diagnostic device registered in the ontology." ;
        rdfs:label "Device" ;
        rdfs:seeAlso <http://dbpedia.org/resource/Medical_device> .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#DeviceType
:DeviceType rdf:type owl:Class ;
            rdfs:comment "Represents the type or category of a device." ;
            rdfs:label "Device Type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FSCAStatus
:FSCAStatus rdf:type owl:Class ;
            rdfs:comment "Represents the status of a field safety corrective action." ;
            rdfs:label "FSCA Status" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#FieldSafetyCorrectiveAction
:FieldSafetyCorrectiveAction rdf:type owl:Class ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty :addressesIncident ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :Incident
                                             ] ;
                             rdfs:comment "Represents a corrective action taken in the field in response to a reported incident." ;
                             rdfs:label "Field Safety Corrective Action" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IVDRFramework
:IVDRFramework rdf:type owl:Class ;
               rdfs:subClassOf :RegulatoryFramework ;
               rdfs:comment "Represents the In Vitro Diagnostic Regulation framework." ;
               rdfs:label "IVDR Framework" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#InVitroDiagnosticDevice
:InVitroDiagnosticDevice rdf:type owl:Class ;
                         rdfs:subClassOf :Device ;
                         rdfs:comment "Represents an in vitro diagnostic device regulated under the ontology." ;
                         rdfs:label "In Vitro Diagnostic Device" ;
                         rdfs:seeAlso <http://dbpedia.org/resource/In_vitro_diagnostics> .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf [ rdf:type owl:Restriction ;
                            owl:onProperty :affectsDevice ;
                            owl:someValuesFrom :Device
                          ] ;
          rdfs:comment "Represents a reported incident associated with a device and a risk." ;
          rdfs:label "Incident" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#IncidentType
:IncidentType rdf:type owl:Class ;
              rdfs:comment "Represents the type of a reported incident." ;
              rdfs:label "Incident Type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#MDRFramework
:MDRFramework rdf:type owl:Class ;
              rdfs:subClassOf :RegulatoryFramework ;
              rdfs:comment "Represents the Medical Device Regulation framework." ;
              rdfs:label "MDR Framework" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Manufacturer
:Manufacturer rdf:type owl:Class ;
              rdfs:comment "Represents the organization responsible for manufacturing a device." ;
              rdfs:label "Manufacturer" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#MedicalDevice
:MedicalDevice rdf:type owl:Class ;
               rdfs:subClassOf :Device ;
               rdfs:comment "Represents a medical device regulated under the ontology." ;
               rdfs:label "Medical Device" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientOutcome
:PatientOutcome rdf:type owl:Class ;
                rdfs:comment "Represents the outcome experienced by the patient in an incident." ;
                rdfs:label "Patient Outcome" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#PatientSex
:PatientSex rdf:type owl:Class ;
            rdfs:comment "Represents the sex category associated with a patient involved in an incident." ;
            rdfs:label "Patient Sex" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ProbabilityLevel
:ProbabilityLevel rdf:type owl:Class ;
                  rdfs:comment "Represents the probability level associated with a risk." ;
                  rdfs:label "Probability Level" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RegulatoryFramework
:RegulatoryFramework rdf:type owl:Class ;
                     rdfs:comment "Represents the regulatory framework under which a device is classified." ;
                     rdfs:label "Regulatory Framework" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#ReportingEntity
:ReportingEntity rdf:type owl:Class ;
                 rdfs:comment "Represents the entity that reports an incident." ;
                 rdfs:label "Reporting Entity" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf [ rdf:type owl:Restriction ;
                        owl:onProperty :hasRiskCategory ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :RiskCategory
                      ] ;
      rdfs:comment "Represents a risk identified for a medical device or in vitro diagnostic device." ;
      rdfs:label "Risk" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskCategory
:RiskCategory rdf:type owl:Class ;
              rdfs:comment "Represents a high-level category used to classify risks." ;
              rdfs:label "Risk Category" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskClass
:RiskClass rdf:type owl:Class ;
           rdfs:comment "Represents the regulatory risk classification assigned to a device." ;
           rdfs:label "Risk Class" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#RiskType
:RiskType rdf:type owl:Class ;
          rdfs:comment "Represents the specific type of a risk." ;
          rdfs:label "Risk Type" .


###  http://www.semanticweb.org/jadie/ontologies/2026/3/medical-device-ivd-ontology#SeverityLevel
:SeverityLevel rdf:type owl:Class ;
               rdfs:comment "Represents the severity level associated with a risk." ;
               rdfs:label "Severity Level" .


